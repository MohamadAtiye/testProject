# Local development (Docker Compose provides its own environment).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stadtloewe
DB_USER=stadtloewe
DB_PASSWORD=stadtloewe

# Use a real secret manager in production. Minimum 32 characters.
JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_ISSUER=stadtloewe
JWT_AUDIENCE=stadtloewe-api
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE_SECONDS=3600

COOKIE_SECURE=0
TRUST_PROXY=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=testPass123
SEED_DEMO=1

ML_BASE_URL=http://127.0.0.1:8000
ML_API_KEY=dev-ml-key
ML_TIMEOUT_MS=120000

ASSIST_RATE_LIMIT=20
ASSIST_RATE_WINDOW_MS=60000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=300000
CONTACT_RATE_LIMIT=10
PROJECT_RATE_LIMIT=10
RATE_WINDOW_MS=60000

METRICS_TOKEN=local-metrics-token
