# Copy to .env and adjust as needed.
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=testPass123

# Local model (llama-server, see run-model.bat)
AI_BASE_URL=http://127.0.0.1:8080
AI_MODEL=local
AI_TIMEOUT=60
# Prompt modules (files in backend/prompts, without .md), comma-separated
# Admin dashboard chat (backend/api/admin/chat.php)
AI_ADMIN_PROMPTS=persona,domain,admin

# Public form-assist endpoint (backend/api/assist.php)
AI_ASSIST_PROMPTS=assist,assist_goals

# Generic default used by src/prompts.php when no list is given
AI_PROMPTS=persona,domain

# Public form-assist endpoint rate limiting (per client IP)
ASSIST_RATE_LIMIT=20
ASSIST_RATE_WINDOW=60
