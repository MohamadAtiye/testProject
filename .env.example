# Copy to .env before running: docker compose up --build
APP_PORT=8080
APP_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

DB_NAME=stadtloewe
DB_USER=stadtloewe
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=testPass123
SEED_DEMO=1

# Use a real secret manager in production. Minimum 32 characters.
JWT_SECRET=dev-only-change-me-please-32-chars-min
COOKIE_SECURE=0

# Shared secret between Node backend and Python ML service.
ML_API_KEY=dev-ml-key
METRICS_TOKEN=change-me

# ML runtime. CUDA is the default for NVIDIA. For CPU-only Docker:
# ML_IMAGE=ghcr.io/ggml-org/llama.cpp:server, AI_NGL=0, and remove
# `gpus: all` from the llama service in docker-compose.yml.
ML_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
AI_MODEL_FILE=Qwen3.5-4B-UD-Q4_K_XL.gguf
AI_CTX=4096
AI_NGL=99
AI_THREADS=4
